# ============================================================================
# MemoryFlow — environment example.  Copy to `.env` and fill in. NEVER commit
# real secrets. The Flutter client only ever uses the URL + anon key (safe to
# ship because Row Level Security protects the data). All powerful secrets
# (service role, Google OAuth secret, Claude/Gelato/Stripe keys) are used
# SERVER-SIDE ONLY (Supabase Edge Function env vars) — never in the app.
# ============================================================================

# ---- Flutter client (passed via --dart-define) ----------------------------
# From `supabase start` (local) or your hosted project's API settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-publishable-key

# ---- Server-side only (Supabase secrets / Edge Function env) ---------------
# Do NOT expose these to the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google sign-in (Supabase Auth → providers). Consumed by supabase/config.toml.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_GOOGLE_SECRET=your-google-oauth-secret

# Reserved for later milestones (server-side Edge Functions only):
# ANTHROPIC_API_KEY=         # Milestone 4 — Claude image understanding
# GELATO_API_KEY=            # Milestone 5 — print fulfillment
# STRIPE_SECRET_KEY=         # Milestone 6 — subscriptions
# STRIPE_WEBHOOK_SECRET=     # Milestone 6
